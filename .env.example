# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your real values never gets committed.

# Recommended: any long random string. Keeps everyone logged in across
# server restarts. If unset, a random one is generated each restart, which
# logs everyone out whenever the server restarts.
SESSION_SECRET=

# Leave this blank/unset to use the local SQLite file (church.db).
# Set it to a PostgreSQL connection string to use a shared, external database.
# Example (from Neon, Supabase, Render Postgres, etc.):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# There is no APP_PASSWORD anymore — each staff member signs in with their
# own username and password instead of one shared password. After setting
# up your .env, create the first account by running:
#   npm run create-admin
